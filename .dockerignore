# Everything the image must not carry. .env especially: secrets are supplied by
# the platform at runtime, never baked into a layer where they survive in the
# image history.
.env
.env.*
!.env.example

node_modules
.next
.git
.github
.claude

tests
*.test.ts
*.log

# Documentation is for the repository, not the runtime.
*.md
!README.md
landing
