// Single-tenant schema: this deployment serves exactly one HVAC company.
// There is deliberately no Organization model and no organizationId column -
// see CONTRIBUTING.md for the decision and its consequences.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lead lifecycle, per README.md. Phase 1 only ever writes NEW; the remaining
/// values are declared now because adding an enum value later costs a
/// migration each, and the lifecycle is already specified.
enum LeadStatus {
  NEW
  CONTACTED
  ENGAGED
  QUALIFIED
  APPOINTMENT_PENDING
  BOOKED
  HUMAN_HANDOFF
  NOT_QUALIFIED
  LOST
  CLOSED
}

model Lead {
  // cuid rather than an auto-increment integer so the API never exposes a
  // sequential internal identifier (STANDARDS.md 11).
  id String @id @default(cuid())

  name           String
  /// Normalised to E.164 before persisting so the dedupe key is stable
  /// regardless of how the website form formatted the number.
  phone          String
  /// Optional per the PRD - every other intake field is mandatory.
  email          String?
  serviceAddress String
  initialMessage String @db.Text

  status LeadStatus @default(NEW)

  /// sha256(normalisedPhone + ':' + trimmedMessage). Unique so that a retried
  /// webhook delivery collides at the database rather than racing a SELECT
  /// that would let both writers through.
  dedupeKey String @unique

  /// Null until the introductory SMS is confirmed sent. Doubles as the work
  /// queue for the retry job that arrives with the real SMS provider.
  introSmsSentAt DateTime?

  /// Set when the customer texts STOP. Consumer SMS opt-out is not optional -
  /// once set, nothing may text this lead again.
  smsOptedOutAt DateTime?

  /// When the customer agreed to be texted. Null means no consent was recorded
  /// and nothing may be sent to them: express written consent is what makes an
  /// automated text lawful, and it is also what the A2P 10DLC registration is
  /// audited against.
  smsConsentAt DateTime?

  /// The disclosure the customer actually agreed to, stored verbatim. The
  /// wording changes over time, and "they consented" is only defensible if we
  /// can produce what they consented to.
  smsConsentText String? @db.Text

  /// Where consent came from, e.g. "website-form". Distinguishes a form tick
  /// from consent captured any other way.
  smsConsentSource String?

  messages     Message[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([email])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

/// Every SMS in either direction. Gives the conversation its history, and
/// makes outbound spend countable (STANDARDS.md 27).
model Message {
  id String @id @default(cuid())

  /// Null when an inbound message arrives from a number we have no lead for.
  /// The message is still stored - discarding a real customer's text because
  /// it does not match a row would be worse than an orphan.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  direction MessageDirection
  /// The customer's number in E.164 - sender for inbound, recipient outbound.
  phone     String
  body      String @db.Text

  /// Provider-assigned id. Unique so a redelivered webhook collides at the
  /// database rather than being processed twice (STANDARDS.md 28).
  providerMessageId String? @unique
  provider          String

  receivedAt DateTime?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([leadId, createdAt])
  @@index([phone, createdAt])
  @@index([direction, sentAt])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// A booked visit. In fixed-slot mode the slot label is the configured string
/// the customer chose; a calendar-backed mode later adds real timestamps
/// without changing how the conversation reaches this point.
model Appointment {
  id String @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// The configured slot label, exactly as offered to the customer.
  slotLabel String
  /// Duration in minutes, captured at booking time - changing the configured
  /// default later must not silently rewrite appointments already made.
  durationMinutes Int

  status AppointmentStatus @default(CONFIRMED)

  /// When the visit actually happens. Null only for rows booked before this
  /// column existed, or when the configured label could not be parsed.
  ///
  /// Without it a slot label was the whole identity of an appointment, so
  /// "Mon-Fri 9am" could exist once in the entire database and six configured
  /// slots meant six bookings ever.
  scheduledAt    DateTime?
  scheduledEndAt DateTime?

  /// Guards double-booking at the database rather than with a read-then-write.
  /// Two customers choosing the same slot simultaneously would both pass a
  /// SELECT; one of them must lose at the unique index instead.
  ///
  /// Now carries the resolved date, so the same weekly window is bookable
  /// again next week rather than being consumed permanently.
  slotKey String @unique

  confirmationSentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([leadId])
  @@index([status, createdAt])
  /// Drives "what is on tomorrow" without scanning.
  @@index([scheduledAt])
}
