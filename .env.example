# Copy to .env and fill in real values. Never commit .env (STANDARDS.md 17).
#
# This file is the whole per-client configuration surface. Standing the system
# up for a different service business means changing values here - no code
# change is required.
#
# Every key below is required by src/config/env.ts. The two files are kept in
# sync by tests/config/env-example.test.ts - add a key to one without the
# other and the test suite fails.

# --- Database ---------------------------------------------------------------
# Postgres only. Development and production must use the same engine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hvac_leads?schema=public"

# --- Lead intake ------------------------------------------------------------
# Shared secret the website form sends in the x-webhook-secret header.
# Minimum 16 characters. Generate with: openssl rand -hex 24
LEAD_WEBHOOK_SECRET="replace-with-a-generated-secret"
# Whether something you control (Railway, Vercel, nginx) writes X-Forwarded-For.
# Off by default: when off the header is ignored for rate-limit bucketing and
# every caller shares one bucket. A blunt limit beats a per-IP limit anyone can
# evade by setting a header.
TRUSTED_PROXY="false"
RATE_LIMIT_MAX_REQUESTS="10"
RATE_LIMIT_WINDOW_MS="60000"

# --- Client identity --------------------------------------------------------
BUSINESS_NAME="Your Business Name"
# Name the assistant signs messages with.
REP_NAME="the team"
# E.164 calling code applied to phone numbers submitted without one.
BUSINESS_COUNTRY_CODE="+1"
BUSINESS_TIMEZONE="America/Chicago"
# Quoted to customers verbatim, so write it the way you would say it.
BUSINESS_HOURS="Monday to Friday 8am to 6pm, Saturday 9am to 2pm"
# Structured equivalent used to decide whether we are open right now. Keep
# consistent with the prose above by hand - nothing enforces that they agree.
BUSINESS_OPEN_HOUR="8"
BUSINESS_CLOSE_HOUR="18"
# ISO weekday numbers, 1=Monday .. 7=Sunday.
BUSINESS_OPEN_DAYS="1,2,3,4,5,6"
# Where the business will travel. The assistant must never invent this.
SERVICE_AREA="Chicago Metro, Cook County, DuPage County, Will County"
# Alerted when a conversation is escalated. E.164.
OWNER_PHONE=""

# --- Message copy -----------------------------------------------------------
# Placeholders: {firstName}, {businessName}, {repName}, {time}.
# Unknown placeholders are left visible so a typo is obvious rather than silent.
SMS_INTRO_TEMPLATE="Hi, this is {businessName}! I just got your request and want to help. Can you tell me a little about what's going on with your system?"
SMS_AFTER_HOURS_TEMPLATE="Hi, this is {repName} from {businessName}. We received your request and will follow up first thing in the morning. If this is an emergency, reply EMERGENCY and we will call you right away."
SMS_EMERGENCY_TEMPLATE="Thanks for letting us know - treating this as urgent. {repName} from {businessName} will call you right away."
SMS_BOOKING_CONFIRMATION_TEMPLATE="You're all set! Your appointment with {businessName} is confirmed for {time}. Reply STOP to opt out."
# --- Dashboard access -------------------------------------------------------
# The dashboard shows every customer's name, phone, home address and full
# message history. Leave DASHBOARD_PASSWORD unset and it serves nothing at all
# rather than serving openly.
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
DASHBOARD_PASSWORD=""
# Optional. Defaults to the password above. Set separately to sign every user
# out without changing the password they type.
DASHBOARD_SESSION_SECRET=""
DASHBOARD_SESSION_HOURS="12"

# Reply to HELP. Required by CTIA guidelines and promised in the consent
# disclosure on the lead form, so it must name the business and repeat how to
# opt out. {ownerPhone} falls back to the business name when OWNER_PHONE is unset.
SMS_HELP_TEMPLATE="{businessName}: this is an automated assistant for booking service visits. Call {ownerPhone} to reach a person. Reply STOP to opt out. Msg & data rates may apply."
# Replies to "cancel my appointment". Handled in code, never by the model - a
# customer told their visit is cancelled when it is not will not be there when
# the technician arrives, and neither will the business.
SMS_CANCELLATION_TEMPLATE="That's cancelled - nothing is booked for you now. Reply any time if you'd like to arrange another visit."
SMS_NOTHING_TO_CANCEL_TEMPLATE="You don't have a visit booked with {businessName} at the moment, so there's nothing to cancel."
AFTER_HOURS_REPLY_ENABLED="true"

# Sent to OWNER_PHONE when an emergency is detected. Goes to the business, not
# a customer, so it carries who/what number/what they said and has no opt-out
# line. Truncated to keep the alert to a single SMS segment.
SMS_OWNER_ALERT_TEMPLATE="EMERGENCY: {firstName} ({phone}) just texted {businessName} - \"{message}\" Call them now."

# --- Public demo form -------------------------------------------------------
# /demo and /api/demo/lead send a real text to whatever number is typed in, so
# they stay off unless switched on deliberately. The hourly cap is shared
# across all visitors - the free SMS tier is 50 a month.
DEMO_FORM_ENABLED="false"
DEMO_FORM_HOURLY_LIMIT="5"

# --- Booking (Phase 5) ------------------------------------------------------
# "fixed" offers the slots below; "calendar" reads real availability.
BOOKING_MODE="fixed"
APPOINTMENT_DURATION_MINUTES="90"
AVAILABLE_TIME_SLOTS="Mon-Fri 9am,Mon-Fri 11am,Mon-Fri 2pm,Mon-Fri 4pm,Sat 10am,Sat 12pm"

# --- Safety -----------------------------------------------------------------
# Comma-separated. Matched in application code, not by the model - an emergency
# must be caught even when the AI provider is unreachable.
EMERGENCY_KEYWORDS="no heat,no ac,gas smell,flooding,water leak,carbon monoxide,smoke,system sparking,no hot water"

# --- AI ---------------------------------------------------------------------
AI_PROVIDER="openai"
# Optional override. Leave blank to use the provider's default:
#   openai    -> gpt-4o-mini
#   anthropic -> claude-haiku-4-5
AI_MODEL=""
# Only the key for the selected AI_PROVIDER is required.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- SMS provider -----------------------------------------------------------
# "console"  logs outbound messages instead of sending them - costs nothing.
# "textbee"  sends through a TextBee-connected Android handset (testing).
# "twilio"   not implemented yet - needs the client's own account.
SMS_PROVIDER="console"

# Hard ceiling on real texts per calendar month. The TextBee free tier allows
# 50; this stops a retry loop exhausting that in seconds.
SMS_MONTHLY_LIMIT="50"

# Required only when SMS_PROVIDER=textbee. From the TextBee dashboard.
TEXTBEE_API_KEY=""
TEXTBEE_DEVICE_ID=""
# Must match the signing secret set on the webhook. 20 characters minimum.
TEXTBEE_WEBHOOK_SECRET=""

# --- Trade / vertical -------------------------------------------------------
# Everything in this block is what makes the assistant industry-specific.
# Change these four values and the same codebase serves a plumber, an
# electrician, or a roofer - no code edit required.
BUSINESS_VERTICAL="HVAC"
TECHNICIAN_NOUN="technician"
# Problem categories the assistant tries to identify, comma-separated.
SERVICE_TYPES="not cooling,not heating,strange noise,no hot water,maintenance,replacement quote"
# Hazards that must stop qualification and escalate, comma-separated.
# Described to the model; EMERGENCY_KEYWORDS is the code-side match.
SAFETY_HAZARDS="gas,smoke,sparking,burning smells,carbon monoxide"

# --- Conversation tuning ----------------------------------------------------
SMS_MAX_LENGTH="320"
AI_HISTORY_LIMIT="20"
AI_MAX_OUTPUT_TOKENS="160"
AI_TEMPERATURE="0.4"
WEBHOOK_MAX_AGE_MINUTES="5"
SMS_WEBHOOK_RATE_LIMIT="120"

# --- docker-compose only ----------------------------------------------------
# Read by docker-compose.yml, not by the application. Defaults shown.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="hvac_leads"
POSTGRES_PORT="5432"
POSTGRES_VERSION="16"
COMPOSE_PROJECT_NAME="hvac"
